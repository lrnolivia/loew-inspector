{
  "id": "field",
  "name": "field",
  "repository": "lrnolivia/field",
  "managed": true,
  "default_branch": "main",
  "implementation": {
    "branch_prefixes": [
      "field/"
    ],
    "excluded_branches": [
      "main",
      "field/control",
      "relay-write-proof"
    ],
    "draft_pr_required": true,
    "merge_method": "squash"
  },
  "runtime": {
    "kind": "node",
    "node_version": "22",
    "package_manager": "npm",
    "lockfile": "package-lock.json",
    "install": "npm ci"
  },
  "validation": {
    "build": "npm run build:all",
    "test": "npm run test:run",
    "lint": "npm run lint",
    "required": [
      "install",
      "build",
      "test",
      "lint"
    ]
  },
  "qa": {
    "authority": "lrnolivia/loew-runner@main/LOEW_CHAT_BIBLE.md#11-qa-law",
    "runner_first": true,
    "runtime_required_for_web_visible_changes": true,
    "routine_engine": "deterministic-inspector-github-chromium",
    "browser_run": "exploratory-or-session-only",
    "real_project_entrypoint": "/qa/work/<projectId>",
    "smoke_only_entrypoint": "/builder/noauth",
    "project_overlay": ".field/handoff-kit/qa/BROWSER_PREVIEW_QA_PROTOCOL.md",
    "preview_endpoints": [
      "https://field.loew.fi",
      "https://canvas.field.loew.fi",
      "https://preview.field.loew.fi"
    ]
  },
  "promotion": {
    "automatic": true,
    "repair_artificial_blockers": true,
    "exact_sha_gate": true,
    "max_transient_retries": 2,
    "auto_update_branch": true,
    "auto_create_pr": true,
    "auto_merge": true
  },
  "safety": {
    "force_push": false,
    "bypass_required_checks": false,
    "semantic_conflict_resolution": "block",
    "dependency_intent_changes": "block"
  },
  "guidance": {
    "universal_authority": "lrnolivia/loew-runner@main/LOEW_CHAT_BIBLE.md",
    "local_bootstrap": "AGENTS.md",
    "historical_repository_targets_are_non_authoritative": true
  }
}
