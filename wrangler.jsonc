{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loew-inspector",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "relay.loew.fi",
      "custom_domain": true
    },
    {
      "pattern": "relay-inspector.loew.fi",
      "custom_domain": true
    },
    {
      "pattern": "inspector.loew.fi",
      "custom_domain": true
    }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "8df30cd302a4d4a4c01db9863c712166",
    "RELAY_CLOUDFLARE_WRITE_SCRIPTS": "loew-inspector",
    "RELAY_GITHUB_APP_ID": "5133504"
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "loew-inspector-evidence"
    }
  ]
}
