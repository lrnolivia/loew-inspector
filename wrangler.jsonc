{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loew-inspector-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "inspector.loew.fi", "custom_domain": true }],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  }
}
